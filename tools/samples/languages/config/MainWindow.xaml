<Window x:Class="Fili.Langs.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Fili.Langs"
        Title="Orders" Height="450" Width="800">
  <!-- The order grid and its total. -->
  <Window.Resources>
    <local:MoneyConverter x:Key="Money" />
    <SolidColorBrush x:Key="Accent" Color="#9184EE" />
  </Window.Resources>
  <DockPanel Margin="8">
    <TextBlock DockPanel.Dock="Bottom"
               Text="{Binding Total, Converter={StaticResource Money}}" />
    <DataGrid ItemsSource="{Binding Lines}" AutoGenerateColumns="False">
      <DataGrid.Columns>
        <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
