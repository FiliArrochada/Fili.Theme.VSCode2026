{
  "name": "fili-vscode2026",
  "displayName": "Fili.VSCode2026",
  "description": "Visual Studio 2026's themes for VS Code — Dark, Light, the eleven tinted themes and both Extra Contrast editors — rebuilt from Visual Studio's own Fluent theme tokens, with Roslyn-accurate C# and a Solution Explorer icon theme.",
  "version": "0.7.1",
  "publisher": "FiliArrochada",
  "author": "FiliArrochada",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/FiliArrochada/Fili.Theme.VSCode2026.git"
  },
  "bugs": {
    "url": "https://github.com/FiliArrochada/Fili.Theme.VSCode2026/issues"
  },
  "homepage": "https://github.com/FiliArrochada/Fili.Theme.VSCode2026#readme",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "visual studio",
    "visual studio 2026",
    "fluent",
    "dark",
    "light",
    "csharp"
  ],
  "galleryBanner": {
    "color": "#1C1C1C",
    "theme": "dark"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "commands": [
      {
        "command": "fili-vscode2026.applyLayout",
        "title": "Apply Visual Studio 2026 Layout",
        "category": "Fili.VSCode2026"
      },
      {
        "command": "fili-vscode2026.removeLayout",
        "title": "Remove Visual Studio 2026 Layout",
        "category": "Fili.VSCode2026"
      }
    ],
    "themes": [
      {
        "label": "Fili.VSCode2026 Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/fili-vscode2026-dark-color-theme.json"
      },
      {
        "label": "Fili.VSCode2026 Light",
        "uiTheme": "vs",
        "path": "./themes/fili-vscode2026-light-color-theme.json"
      },
      {
        "label": "Fili.VSCode2026 Light (Bubblegum)",
        "uiTheme": "vs",
        "path": "./themes/fili-vscode2026-bubblegum-color-theme.json"
      },
      {
        "label": "Fili.VSCode2026 Light (Cool Breeze)",
        "uiTheme": "vs",
        "path": "./themes/fili-vscode2026-cool-breeze-color-theme.json"
      },
      {
        "label": "Fili.VSCode2026 Dark (Cool Slate)",
        "uiTheme": "vs-dark",
        "path": "./themes/fili-vscode2026-cool-slate-color-theme.json"
      },
      {
        "label": "Fili.VSCode2026 Dark (Extra Contrast)",
        "uiTheme": "vs-dark",
        "path": "./themes/fili-vscode2026-dark-extra-contrast-color-theme.json"
      },
      {
        "label": "Fili.VSCode2026 Light (Icy Mint)",
        "uiTheme": "vs",
        "path": "./themes/fili-vscode2026-icy-mint-color-theme.json"
      },
      {
        "label": "Fili.VSCode2026 Dark (Juicy Plum)",
        "uiTheme": "vs-dark",
        "path": "./themes/fili-vscode2026-juicy-plum-color-theme.json"
      },
      {
        "label": "Fili.VSCode2026 Light (Extra Contrast)",
        "uiTheme": "vs",
        "path": "./themes/fili-vscode2026-light-extra-contrast-color-theme.json"
      },
      {
        "label": "Fili.VSCode2026 Light (Mango Paradise)",
        "uiTheme": "vs",
        "path": "./themes/fili-vscode2026-mango-paradise-color-theme.json"
      },
      {
        "label": "Fili.VSCode2026 Dark (Moonlight Glow)",
        "uiTheme": "vs-dark",
        "path": "./themes/fili-vscode2026-moonlight-glow-color-theme.json"
      },
      {
        "label": "Fili.VSCode2026 Dark (Mystical Forest)",
        "uiTheme": "vs-dark",
        "path": "./themes/fili-vscode2026-mystical-forest-color-theme.json"
      },
      {
        "label": "Fili.VSCode2026 Light (Silky Pink)",
        "uiTheme": "vs",
        "path": "./themes/fili-vscode2026-silky-pink-color-theme.json"
      },
      {
        "label": "Fili.VSCode2026 Dark (Spicy Red)",
        "uiTheme": "vs-dark",
        "path": "./themes/fili-vscode2026-spicy-red-color-theme.json"
      },
      {
        "label": "Fili.VSCode2026 Light (Sunny Day)",
        "uiTheme": "vs",
        "path": "./themes/fili-vscode2026-sunny-day-color-theme.json"
      }
    ],
    "iconThemes": [
      {
        "id": "fili-vscode2026-icons",
        "label": "Fili.VSCode2026 Icons",
        "path": "./icons/fili-vscode2026-icon-theme.json"
      }
    ],
    "productIconThemes": [
      {
        "id": "fili-vscode2026-product-icons",
        "label": "Fili.VSCode2026 Fluent Icons",
        "path": "./product-icons/fili-vscode2026-product-icon-theme.json"
      }
    ],
    "configurationDefaults": {
      "workbench.iconTheme": "fili-vscode2026-icons",
      "workbench.tree.indent": 12,
      "workbench.tree.renderIndentGuides": "none",
      "explorer.compactFolders": false,
      "workbench.activityBar.location": "top",
      "workbench.activityBar.compact": true,
      "workbench.productIconTheme": "fili-vscode2026-product-icons"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check",
    "test": "node test/layout.test.cjs",
    "coverage": "node scripts/build.mjs --coverage",
    "registry": "node scripts/registry.mjs",
    "variants": "node scripts/variants.mjs",
    "package": "npm run check && npx --yes @vscode/vsce package --no-dependencies",
    "publish": "npm run check && npx --yes @vscode/vsce publish --no-dependencies",
    "publish:ovsx": "npm run check && npx --yes ovsx publish --no-dependencies"
  }
}
