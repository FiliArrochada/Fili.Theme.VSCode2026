  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check",
    "coverage": "node scripts/build.mjs --coverage",
    "registry": "node scripts/registry.mjs",
    "variants": "node scripts/variants.mjs",
    "package": "npm run check && npx --yes @vscode/vsce package --no-dependencies --allow-missing-repository --no-rewrite-relative-links"
