        "path": "./themes/fili-vscode2026-cool-slate-color-theme.json"
      },
      {
        "label": "Fili.VSCode2026 Dark (Extra Contrast)",
        "uiTheme": "vs-dark",
        "path": "./themes/fili-vscode2026-dark-extra-contrast-color-theme.json"
